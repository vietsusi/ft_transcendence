# Copy this to .env. Never commit real credentials.
# Docker development. Database is exposed locally on 55432.
DATABASE_URL=postgresql://postgres:postgres@db:5432/transcendence
JWT_SECRET=local-demo-change-before-publishing
API_KEY=local-demo-admin-key
FRONTEND_URL=http://localhost:5173
# Optional TMDB API read access token for the main seed; blank uses fallback movies.
TMDB_API_KEY=
CHAT_MODE=demo
# Set CHAT_MODE=live when configuring a model. Include /v1 if your provider requires it.
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
